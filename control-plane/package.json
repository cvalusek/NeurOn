{
  "name": "neuron-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "lint": "eslint \"src/**/*.ts\"",
    "changes:check": "node scripts/check-release-notes.js",
    "docs:screenshots": "tsx scripts/capture-doc-screenshots.ts",
    "migrate:sqlite-to-postgres": "node dist/scripts/migrateSqliteToPostgres.js",
    "postgres:local-config": "node scripts/create-postgres-local-config.js"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.600.0",
    "@aws-sdk/client-ec2": "^3.1078.0",
    "@aws-sdk/client-ecs": "^3.600.0",
    "@aws-sdk/client-pricing": "^3.1103.0",
    "@aws-sdk/client-secrets-manager": "^3.1105.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.1.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
