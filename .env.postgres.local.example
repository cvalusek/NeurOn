# Copy with `node control-plane/scripts/create-postgres-local-config.js` instead of using these placeholders.
POSTGRES_USER=neuron
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=neuron
DATABASE_URL=postgresql://neuron:replace-with-a-long-random-password@postgres:5432/neuron
POSTGRES_DRY_RUN_DATABASE_URL=postgresql://neuron:replace-with-a-long-random-password@postgres:5432/neuron_dry_run
TEST_DATABASE_URL=postgresql://neuron:replace-with-a-long-random-password@postgres:5432/neuron_test
POSTGRES_POOL_MAX=10
